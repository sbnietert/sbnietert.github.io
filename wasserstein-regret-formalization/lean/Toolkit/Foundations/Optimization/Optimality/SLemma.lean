/-!
# The S-lemma under strict feasibility

For real polynomials of total degree at most two, strict feasibility of one
quadratic inequality makes nonnegativity on its sublevel set equivalent to
a global nonnegative certificate with a nonnegative scalar multiplier.
The predicate IsQuadraticFunction describes these functions, and s_lemma gives
the equivalence without convexity or definiteness assumptions.

Supporting results provide homogenization in one extra coordinate, extension
of simultaneous strict negativity from the coordinate-one slice, Dines's
convexity theorem for the joint range of two quadratic forms, and a normalized
separating multiplier for a convex set of real pairs. The development reuses
Mathlib's quadratic forms, polynomial evaluation, intermediate value theorem,
and geometric Hahn–Banach separation.

These results apply to robust optimization, trust-region problems, and
quadratic certificates, independently of any particular statistical model.

Reference: Imre Pólik and Tamás Terlaky, *A Survey of the S-Lemma*, SIAM Review
49(3) (2007), 371–418, Theorem 2.2, p. 376, and Proposition 2.3, pp. 376–377.
DOI: https://doi.org/10.1137/S003614450444614X.
-/

@[expose] public section

namespace Toolkit.Foundations.Optimization.Optimality

/-- For [a real polynomial in finitely many coordinates](hyp:p) whose
[total degree is at most two](hyp:hp), [there is a homogeneous quadratic
form in one additional real coordinate that equals the polynomial whenever
that coordinate is one](goal). -/
theorem exists_quadraticForm_slice {n : ℕ}
    (p : MvPolynomial (Fin n) ℝ) (hp : p.totalDegree ≤ 2) :
    ∃ Q : QuadraticForm ℝ ((Fin n → ℝ) × ℝ),
      ∀ x : Fin n → ℝ, Q (x, 1) = MvPolynomial.eval x p := by
  classical
  let t : ((Fin n → ℝ) × ℝ) →ₗ[ℝ] ℝ := LinearMap.snd ℝ _ _
  let v (i : Fin n) : ((Fin n → ℝ) × ℝ) →ₗ[ℝ] ℝ :=
    (LinearMap.proj i).comp (LinearMap.fst ℝ _ _)
  have hmono (d : Fin n →₀ ℕ) (hd : d.toMultiset.card ≤ 2) :
      ∃ Q : QuadraticForm ℝ ((Fin n → ℝ) × ℝ),
        ∀ x, Q (x, 1) = d.prod (fun i k => x i ^ k) := by
    have hc : d.toMultiset.card = 0 ∨ d.toMultiset.card = 1 ∨
        d.toMultiset.card = 2 := by omega
    rcases hc with hc | hc | hc
    · have he : d = 0 := Multiset.toFinsupp.symm.injective
        (by simpa using Multiset.card_eq_zero.mp hc)
      subst d
      exact ⟨QuadraticMap.linMulLin t t, by simp [t]⟩
    · obtain ⟨i, hi⟩ := Multiset.card_eq_one.mp hc
      have he : d = Finsupp.single i 1 :=
        Multiset.toFinsupp.symm.injective (by simpa using hi)
      subst d
      exact ⟨QuadraticMap.linMulLin (v i) t, by simp [v, t]⟩
    · obtain ⟨i, j, hij⟩ := Multiset.card_eq_two.mp hc
      have he : d = Finsupp.single i 1 + Finsupp.single j 1 :=
        Multiset.toFinsupp.symm.injective (by simpa using hij)
      subst d
      refine ⟨QuadraticMap.linMulLin (v i) (v j), ?_⟩
      intro x
      simp [v, Finsupp.prod_add_index, pow_add]
  have hrep (d : {d // d ∈ p.support}) :
      ∃ Q : QuadraticForm ℝ ((Fin n → ℝ) × ℝ),
        ∀ x, Q (x, 1) = d.val.prod (fun i k => x i ^ k) :=
    hmono d.val (by simpa [Function.id_def] using (MvPolynomial.le_totalDegree d.property).trans hp)
  choose Q hQ using hrep
  refine ⟨∑ d : {d // d ∈ p.support}, p.coeff d.val • Q d, ?_⟩
  intro x
  simp only [sum_apply, smul_apply, smul_eq_mul, hQ]
  rw [MvPolynomial.eval_eq]
  simpa only [Finsupp.prod] using
    (Finset.sum_coe_sort p.support (fun d => p.coeff d * d.prod (fun i k => x i ^ k)))

/-- For [two homogeneous quadratic forms on a real vector space with an
additional real coordinate](hyp:Q,R), if [no input with additional coordinate
one makes both forms negative](hyp:hslice), then [no input anywhere makes
both forms negative](goal). -/
theorem no_strict_pair_of_no_strict_pair_slice
    {V : Type*} [AddCommGroup V] [Module ℝ V]
    (Q R : QuadraticForm ℝ (V × ℝ))
    (hslice : ¬∃ x : V, Q (x, 1) < 0 ∧ R (x, 1) < 0) :
    ¬∃ z : V × ℝ, Q z < 0 ∧ R z < 0 := by
  have hn (x : V) (t : ℝ) (ht : t ≠ 0)
      (hQ : Q (x, t) < 0) (hR : R (x, t) < 0) : False := by
    apply hslice
    have he : (t⁻¹ • x, (1 : ℝ)) = t⁻¹ • (x, t) := by
      simp [Prod.smul_mk, ht]
    refine ⟨t⁻¹ • x, ?_, ?_⟩
    · rw [he, Q.map_smul, smul_eq_mul]
      exact mul_neg_of_pos_of_neg (mul_self_pos.mpr (inv_ne_zero ht)) hQ
    · rw [he, R.map_smul, smul_eq_mul]
      exact mul_neg_of_pos_of_neg (mul_self_pos.mpr (inv_ne_zero ht)) hR
  rintro ⟨⟨x, t⟩, hQ, hR⟩
  by_cases ht : t = 0
  · subst t
    have cQ := (Q.hasLineDerivAt (x, (0 : ℝ)) (0, (1 : ℝ))).continuousAt
    have cR := (R.hasLineDerivAt (x, (0 : ℝ)) (0, (1 : ℝ))).continuousAt
    have eQ : ∀ᶠ s : ℝ in nhds 0, Q (x, s) < 0 := by
      simpa using cQ.eventually_lt_const (by simpa using hQ)
    have eR : ∀ᶠ s : ℝ in nhds 0, R (x, s) < 0 := by
      simpa using cR.eventually_lt_const (by simpa using hR)
    obtain ⟨ε, hε, he⟩ := Metric.eventually_nhds_iff.mp (eQ.and eR)
    have hd : dist (ε / 2) 0 < ε := by
      rw [Real.dist_eq, sub_zero, abs_of_pos (by positivity)]
      linarith
    have hs := he hd
    exact hn x (ε / 2) (by positivity) hs.1 hs.2
  · exact hn x t ht hQ hR

/-- For [two homogeneous quadratic forms on a real vector space](hyp:Q,R)
and [two vectors in that space](hyp:x,y), [there is a single vector at which
each form equals the sum of its values at the two original vectors](goal). -/
theorem joint_quadratic_range_add
    {V : Type*} [AddCommGroup V] [Module ℝ V] (Q R : QuadraticForm ℝ V) (x y : V) :
    ∃ z : V, Q z = Q x + Q y ∧ R z = R x + R y := by
  have expand (S : QuadraticForm ℝ V) (a b : ℝ) :
      S (a • x + b • y) =
        a * a * S x + b * b * S y + a * b * QuadraticMap.polar S x y := by
    rw [QuadraticMap.map_add S, QuadraticMap.map_smul, QuadraticMap.map_smul,
      QuadraticMap.polar_smul_left, QuadraticMap.polar_smul_right]
    simp only [smul_eq_mul]
    ring
  have nonzero (Q R : QuadraticForm ℝ V) (hA : Q x + Q y ≠ 0) :
      ∃ z : V, Q z = Q x + Q y ∧ R z = R x + R y := by
    let A := Q x + Q y
    let B := R x + R y
    change A ≠ 0 at hA
    let f : ℝ → ℝ := fun t =>
      ((1 - t) * (1 - t) * Q x + t * t * Q y +
        (1 - t) * t * QuadraticMap.polar Q x y) * B -
      ((1 - t) * (1 - t) * R x + t * t * R y +
        (1 - t) * t * QuadraticMap.polar R x y) * A
    have hf : Continuous f := by dsimp [f]; fun_prop
    have hend : f 1 = -f 0 := by dsimp [f, A, B]; ring
    obtain ⟨t, ht⟩ : ∃ t, f t = 0 := by
      rcases le_total (f 0) 0 with h | h
      · exact mem_range_of_exists_le_of_exists_ge hf ⟨0, h⟩
          ⟨1, by rw [hend]; linarith⟩
      · exact mem_range_of_exists_le_of_exists_ge hf
          ⟨1, by rw [hend]; linarith⟩ ⟨0, h⟩
    let u := (1 - t) • x + t • y
    let v := (-t) • x + (1 - t) • y
    let k := (1 - t) * (1 - t) + t * t
    have hk : 0 < k := by dsimp [k]; nlinarith [sq_nonneg (t - 1 / 2)]
    have hsum (S : QuadraticForm ℝ V) : S u + S v = k * (S x + S y) := by
      dsimp [u, v, k]
      rw [expand, expand]
      ring
    have hu : Q u * B - R u * A = 0 := by
      dsimp [u]
      rw [expand, expand]
      exact ht
    have hv : Q v * B - R v * A = 0 := by
      have hq := hsum Q
      have hr := hsum R
      change Q u + Q v = k * A at hq
      change R u + R v = k * B at hr
      linear_combination B * hq - A * hr - hu
    have scale (w : V) (hw : Q w * B - R w * A = 0)
        (hp : 0 < Q w / A) : ∃ z : V, Q z = A ∧ R z = B := by
      let c := Q w / A
      have hc : 0 < c := hp
      have hq : Q w = c * A := by dsimp [c]; field_simp [hA]
      have hr : R w = c * B := by
        apply (mul_right_cancel₀ hA)
        rw [hq] at hw
        linear_combination -hw
      refine ⟨Real.sqrt c⁻¹ • w, ?_, ?_⟩
      · rw [QuadraticMap.map_smul]
        simp only [smul_eq_mul, Real.mul_self_sqrt (le_of_lt (inv_pos.mpr hc))]
        rw [hq]
        field_simp
      · rw [QuadraticMap.map_smul]
        simp only [smul_eq_mul, Real.mul_self_sqrt (le_of_lt (inv_pos.mpr hc))]
        rw [hr]
        field_simp
    have hrat : Q u / A + Q v / A = k := by
      rw [← add_div, hsum Q]
      change k * A / A = k
      exact mul_div_cancel_right₀ k hA
    by_cases hp : 0 < Q u / A
    · exact scale u hu hp
    · exact scale v hv (by linarith)
  by_cases hQ : Q x + Q y = 0
  · by_cases hR : R x + R y = 0
    · exact ⟨0, by simpa using hQ.symm, by simpa using hR.symm⟩
    · obtain ⟨z, hzR, hzQ⟩ := nonzero R Q hR
      exact ⟨z, hzQ, hzR⟩
  · exact nonzero Q R hQ

/-- For [two homogeneous quadratic forms on a real vector space](hyp:Q,R),
[the set of pairs consisting of their values at the same vector is convex](goal).

This is Dines's theorem; the vector space need not be finite-dimensional. -/
theorem convex_joint_quadratic_range
    {V : Type*} [AddCommGroup V] [Module ℝ V] (Q R : QuadraticForm ℝ V) :
    Convex ℝ (Set.range fun x : V => (Q x, R x)) := by
  intro p hp q hq a b ha hb _hab
  rcases hp with ⟨x, rfl⟩
  rcases hq with ⟨y, rfl⟩
  obtain ⟨z, hQ, hR⟩ :=
    joint_quadratic_range_add Q R (Real.sqrt a • x) (Real.sqrt b • y)
  refine ⟨z, Prod.ext ?_ ?_⟩
  · change Q z = a * Q x + b * Q y
    simpa only [QuadraticMap.map_smul, smul_eq_mul,
      Real.mul_self_sqrt ha, Real.mul_self_sqrt hb] using hQ
  · change R z = a * R x + b * R y
    simpa only [QuadraticMap.map_smul, smul_eq_mul,
      Real.mul_self_sqrt ha, Real.mul_self_sqrt hb] using hR

/-- If [a set of real pairs is convex](hyp:hconvex), [some pair in the set
has a negative second coordinate](hyp:hstrict), and [no pair in the set has
two negative coordinates](hyp:hdisjoint), then [there is a nonnegative weight
such that the first coordinate plus that weight times the second coordinate
is nonnegative for every pair in the set](goal). -/
theorem exists_nonneg_multiplier_of_convex
    {C : Set (ℝ × ℝ)} (hconvex : Convex ℝ C)
    (hstrict : ∃ p ∈ C, p.2 < 0)
    (hdisjoint : ∀ p ∈ C, ¬(p.1 < 0 ∧ p.2 < 0)) :
    ∃ y : ℝ, 0 ≤ y ∧ ∀ p ∈ C, 0 ≤ p.1 + y * p.2 := by
  let N : Set (ℝ × ℝ) := Set.Iio (0 : ℝ) ×ˢ Set.Iio (0 : ℝ)
  have hNconvex : Convex ℝ N := (convex_Iio 0).prod (convex_Iio 0)
  have hNopen : IsOpen N := isOpen_Iio.prod isOpen_Iio
  have hNC : Disjoint N C := Set.disjoint_left.mpr fun p hp hpC =>
    hdisjoint p hpC hp
  obtain ⟨L, u, hN, hC⟩ :=
    geometric_hahn_banach_open hNconvex hNopen hconvex hNC
  let alpha := L (1, 0)
  let beta := L (0, 1)
  have hL (p : ℝ × ℝ) : L p = alpha * p.1 + beta * p.2 := by
    have hp : p = p.1 • (1, 0) + p.2 • (0, 1) := by ext <;> simp
    conv_lhs => rw [hp, map_add, map_smul, map_smul]
    change p.1 * alpha + p.2 * beta = _
    ring
  have hclosure : ∀ p ∈ closure N, L p ≤ u := by
    exact closure_minimal (fun q hq => (hN q hq).le)
      (isClosed_le L.continuous continuous_const)
  have hu : 0 ≤ u := by
    have hz : (0 : ℝ × ℝ) ∈ closure N := by
      rw [show N = Set.Iio (0 : ℝ) ×ˢ Set.Iio (0 : ℝ) from rfl, closure_prod_eq]
      exact ⟨by simp, by simp⟩
    simpa using hclosure 0 hz
  have halpha : 0 ≤ alpha := by
    by_contra h
    have ha : alpha < 0 := lt_of_not_ge h
    have hx : u / alpha - 1 < 0 := by
      have := div_nonpos_of_nonneg_of_nonpos hu ha.le
      linarith
    have hm : (u / alpha - 1, (0 : ℝ)) ∈ closure N := by
      rw [show N = Set.Iio (0 : ℝ) ×ˢ Set.Iio (0 : ℝ) from rfl, closure_prod_eq]
      exact ⟨by simpa using hx.le, by simp⟩
    have hn := hclosure _ hm
    rw [hL] at hn
    dsimp at hn
    have he : alpha * (u / alpha - 1) = u - alpha := by
      field_simp [ne_of_lt ha]
    linarith
  have hbeta : 0 ≤ beta := by
    by_contra h
    have hb : beta < 0 := lt_of_not_ge h
    have hx : u / beta - 1 < 0 := by
      have := div_nonpos_of_nonneg_of_nonpos hu hb.le
      linarith
    have hm : ((0 : ℝ), u / beta - 1) ∈ closure N := by
      rw [show N = Set.Iio (0 : ℝ) ×ˢ Set.Iio (0 : ℝ) from rfl, closure_prod_eq]
      exact ⟨by simp, by simpa using hx.le⟩
    have hn := hclosure _ hm
    rw [hL] at hn
    dsimp at hn
    have he : beta * (u / beta - 1) = u - beta := by
      field_simp [ne_of_lt hb]
    linarith
  obtain ⟨p, hpC, hpneg⟩ := hstrict
  have hnormal : alpha ≠ 0 ∨ beta ≠ 0 := by
    by_contra h
    push Not at h
    have hn := hN (-1, -1) ⟨by norm_num, by norm_num⟩
    have hc := hC p hpC
    rw [hL] at hn hc
    rcases h with ⟨ha, hb⟩
    simp [ha, hb] at hn hc
    linarith
  have hapos : 0 < alpha := by
    rcases halpha.eq_or_lt with ha | ha
    · have hbpos : 0 < beta := lt_of_le_of_ne hbeta (by
        rcases hnormal with hn | hn
        · exact (hn ha.symm).elim
        · exact Ne.symm hn)
      have hc := hC p hpC
      rw [hL, ← ha] at hc
      have := mul_neg_of_pos_of_neg hbpos hpneg
      nlinarith
    · exact ha
  refine ⟨beta / alpha, div_nonneg hbeta hapos.le, ?_⟩
  intro q hq
  have hc := le_trans hu (hC q hq)
  rw [hL] at hc
  apply (mul_nonneg_iff_of_pos_left hapos).mp
  convert hc using 1; field_simp

/-- A [real-valued function of finitely many real coordinates](hyp:f)
[is a quadratic function](goal) if some polynomial [has total degree at most
two](step:1) and [equals the function at every input](step:2). -/
def IsQuadraticFunction {n : ℕ} (f : (Fin n → ℝ) → ℝ) : Prop :=
  ∃ p : MvPolynomial (Fin n) ℝ, p.totalDegree ≤ 2 ∧
    ∀ x : Fin n → ℝ, MvPolynomial.eval x p = f x

/-- Let f and g be functions from a finite-dimensional real coordinate
space to the reals, with [f a polynomial of total degree at most two](hyp:hf)
and [g a polynomial of total degree at most two](hyp:hg). If [there exists
a point where g is strictly negative](hyp:hstrict), then [there is no point
where f is negative and g is nonpositive if and only if there exists a
nonnegative real number y such that f plus y times g is nonnegative at every
point](goal).

This is the S-lemma under strict feasibility; see Pólik and Terlaky (2007),
Theorem 2.2, p. 376. -/
theorem s_lemma {n : ℕ} {f g : (Fin n → ℝ) → ℝ}
    (hf : IsQuadraticFunction f) (hg : IsQuadraticFunction g)
    (hstrict : ∃ x : Fin n → ℝ, g x < 0) :
    (¬∃ x : Fin n → ℝ, f x < 0 ∧ g x ≤ 0) ↔
      ∃ y : ℝ, 0 ≤ y ∧ ∀ x : Fin n → ℝ, 0 ≤ f x + y * g x := by
  constructor
  · intro hno
    obtain ⟨p, hp, hpf⟩ := hf
    obtain ⟨q, hq, hqg⟩ := hg
    obtain ⟨Q, hQ⟩ := exists_quadraticForm_slice p hp
    obtain ⟨R, hR⟩ := exists_quadraticForm_slice q hq
    have hslice : ¬∃ x : Fin n → ℝ, Q (x, 1) < 0 ∧ R (x, 1) < 0 := by
      rintro ⟨x, hfx, hgx⟩
      rw [hQ x, hpf x] at hfx
      rw [hR x, hqg x] at hgx
      exact hno ⟨x, hfx, hgx.le⟩
    have hhom := no_strict_pair_of_no_strict_pair_slice Q R hslice
    have hpoint : ∃ z ∈ Set.range (fun z => (Q z, R z)), z.2 < 0 := by
      obtain ⟨x, hx⟩ := hstrict
      refine ⟨(Q (x, 1), R (x, 1)), ⟨(x, 1), rfl⟩, ?_⟩
      simpa only [hR x, hqg x] using hx
    have hdisjoint : ∀ z ∈ Set.range (fun z => (Q z, R z)),
        ¬(z.1 < 0 ∧ z.2 < 0) := by
      rintro _ ⟨z, rfl⟩ hz
      exact hhom ⟨z, hz⟩
    obtain ⟨y, hy, hcert⟩ := exists_nonneg_multiplier_of_convex
      (convex_joint_quadratic_range Q R) hpoint hdisjoint
    refine ⟨y, hy, fun x => ?_⟩
    have hx := hcert (Q (x, 1), R (x, 1)) ⟨(x, 1), rfl⟩
    simpa only [hQ x, hR x, hpf x, hqg x] using hx
  · rintro ⟨y, hy, hcert⟩ ⟨x, hfx, hgx⟩
    have hprod : y * g x ≤ 0 := mul_nonpos_of_nonneg_of_nonpos hy hgx
    have hx := hcert x
    linarith

end Toolkit.Foundations.Optimization.Optimality
